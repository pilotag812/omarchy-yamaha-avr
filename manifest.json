{
  "schemaVersion": 1,
  "id": "io.github.bjarkimg.yamaha-avr",
  "name": "Yamaha AVR",
  "version": "1.2.0",
  "author": "Bjarki Már",
  "license": "MIT",
  "description": "Bar remote for Yamaha RX-V575 over YNCA with configurable inputs, smooth DLNA media browsing, playback, tone controls, and DSP modes.",
  "homepage": "https://github.com/pilotag812/omarchy-yamaha-avr",
  "repository": "https://github.com/pilotag812/omarchy-yamaha-avr",
  "keywords": [
    "bar",
    "media",
    "remote",
    "yamaha",
    "avr",
    "ynca",
    "dlna"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Yamaha AVR",
    "description": "Remote for Yamaha RX-V / RX-A receivers over the LAN",
    "category": "Controls",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "deviceName": "Yamaha AVR",
      "host": ""
    },
    "schema": [
      {
        "key": "deviceName",
        "type": "string",
        "label": "Receiver name",
        "defaultValue": "Yamaha AVR"
      },
      {
        "key": "host",
        "type": "string",
        "label": "Receiver IP",
        "defaultValue": ""
      }
    ]
  }
}
